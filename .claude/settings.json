{
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx playwright:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__github",
      "mcp__Vercel__list_*",
      "mcp__Vercel__get_*",
      "mcp__Google_Drive",
      "mcp__Context7",
      "mcp__claude-code-remote"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__create_or_transfer_domain",
      "mcp__Vercel__delete_*"
    ]
  }
}